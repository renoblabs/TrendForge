{
  "max_generation_retries": 2,
  "default_duration_seconds": 5,
  "default_variant_count": 1,
  "allowed_durations": [5, 8, 15, 20, 30],
  "allowed_variant_counts": [1, 3, 5],
  "execution_target": "comfy_cloud",
  "agent_runner": "cursor-agent",
  "agent_prompt_version": "production-agent-v3",
  "output_dir": "data/generated",
  "default_cloud_model": "seedance-2.0",
